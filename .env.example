# Canonical origin of the marketing site. Drives canonical tags, OG URLs,
# sitemap.xml and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://migrio.com

# The product app. Every CTA links here with ?intent= and UTM parameters.
NEXT_PUBLIC_HUB_URL=https://hub.migrio.com

# Analytics. Set GTM *or* GA4, not both. Leave empty in development: the
# dataLayer still fills up so you can verify events in the console.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

# Where contact form submissions are forwarded (Slack, Zapier, your CRM...).
# Server-only. If unset, submissions are logged to the server console.
CONTACT_WEBHOOK_URL=

# Eligibility reports are POSTed here as JSON (to, subject, text, html, report)
# so your mail provider can send them. If unset, the score still opens on the
# dashboard and email is reported as not sent.
ELIGIBILITY_WEBHOOK_URL=

# Optional. When set, answers are POSTed here first and a matching report JSON
# replaces the built-in score. Failures fall back to the built-in engine.
ELIGIBILITY_ENGINE_URL=
